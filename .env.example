# DATABASE_URL: PostgreSQL connection string used by the running app.
# DIRECT_URL: PostgreSQL connection string used only by Prisma Migrate/CLI.
#
# NOTE: Neon's pooled ("-pooler") endpoint uses PgBouncer in transaction-pooling mode,
# which is known to be flaky with Prisma's interactive $transaction() calls (used
# throughout dbController.ts) — connections can be reset mid-transaction. For a
# small-scale app like this one, point BOTH variables at the DIRECT (non-pooler)
# endpoint to avoid that entirely. Only use the "-pooler" endpoint for DATABASE_URL
# if you expect many concurrent users and have verified transactions remain stable.
#
# connection_limit / pool_timeout: without PgBouncer, Prisma's own client-side pool
# (default ~9 connections) can be exhausted when a slow write (large table
# delete+recreate) holds a connection while unrelated reads (auth checks) queue up
# waiting for one — raise both to give more headroom on a low-traffic app like this.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&connect_timeout=30&connection_limit=15&pool_timeout=30"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require&connect_timeout=30"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security Configuration — generate real random values, never reuse these placeholders.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_RANDOM_VALUE"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_VALUE"

# Cloudinary: used for direct browser-to-Cloudinary file uploads (gallery media,
# personnel photos, site logo/favicon) instead of embedding files as base64 in the
# database — much faster and avoids save failures on large files. Get these from
# your Cloudinary dashboard (cloudinary.com) — Cloud name is shown on the main
# dashboard; the upload preset is created under Settings > Upload > Upload presets
# (must be set to "Unsigned"). Neither value is a secret — never put the Cloudinary
# API Secret here or anywhere client-side; unsigned uploads don't need it.
# IMPORTANT: these must be prefixed VITE_ to be readable by the frontend build.
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset_name"
