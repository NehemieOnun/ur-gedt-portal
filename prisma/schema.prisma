generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  permissions String
  users       User[]
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  roleId     String
  active     Boolean   @default(true)
  avatarUrl  String?
  phone      String?
  department String?
  function   String?
  bio        String?
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
  role       Role      @relation(fields: [roleId], references: [id])
}

model SiteSetting {
  id        String   @id @default("1")
  siteName  String   @default("UR-GEDT Portal")
  logo      String   @default("/logo.jpg")
  favicon   String   @default("/favicon.ico")
  address   String   @default("Université de Lubumbashi, Route Kasapa, Lubumbashi, RDC")
  phone     String   @default("+243 990 000 000")
  email     String   @default("contact@urgedt-unilu.org")
  facebook  String   @default("https://facebook.com")
  linkedin  String   @default("https://linkedin.com")
  twitter   String   @default("https://x.com")
  youtube   String   @default("https://youtube.com")
  github    String   @default("https://github.com")
  whatsapp  String   @default("https://wa.me/243990000000")
  updatedAt DateTime @default(now()) @updatedAt
}

model News {
  id        String   @id @default(uuid())
  title     String
  content   String
  date      String
  author    String
  image     String?
  category  String
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  date        String
  status      String
  budget      Float
  researchers String
  createdAt   DateTime @default(now())
}

model Project {
  id                    String   @id @default(uuid())
  title                 String
  status                String
  progress              Int
  startYear             Int
  duration              String
  principalInvestigator String
  description           String
  objectives            String
  partners              String
  budgetAmount          Float
  spentAmount           Float
  lastUpdate            String
  createdAt             DateTime @default(now())
}

model Publication {
  id          String   @id @default(uuid())
  title       String
  authors     String
  journal     String
  year        Int
  type        String
  status      String
  doi         String?
  abstractUrl String?
  createdAt   DateTime @default(now())
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String
  url         String
  date        String
  createdAt   DateTime @default(now())
}

model Partner {
  id              String   @id @default(uuid())
  name            String
  type            String
  logo            String
  website         String?
  cooperationType String
  createdAt       DateTime @default(now())
}

model ContactMessage {
  id          String   @id @default(uuid())
  senderName  String
  senderEmail String
  subject     String
  message     String
  date        String
  status      String
  createdAt   DateTime @default(now())
}

model Recipe {
  id          String   @id @default(uuid())
  description String
  source      String
  amount      Float
  date        String
  recordedBy  String
  type        String
  createdAt   DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  description String
  beneficiary String
  amount      Float
  category    String
  date        String
  status      String
  recordedBy  String
  createdAt   DateTime @default(now())
}

model Budget {
  id                 String @id @default(uuid())
  year               Int    @unique
  totalBudget        Float
  allocatedResearch  Float
  allocatedLogistics Float
  allocatedEquipment Float
  allocatedPersonnel Float
}

model Log {
  id         String   @id @default(uuid())
  userId     String?
  userName   String
  userRole   String
  action     String
  details    String
  timestamp  DateTime @default(now())
  ip         String?
  userAgent  String?
  oldContent String?
  newContent String?
}

model Notification {
  id            String   @id @default(uuid())
  title         String
  message       String
  type          String
  isRead        Boolean  @default(false)
  recipientRole String?
  createdAt     DateTime @default(now())
}
