datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Super Administrateur, Administrateur, Directeur, Comptable, Chercheur, Secrétaire, Visiteur
  description String?
  permissions String   // JSON string of permissions or simple string
  users       User[]
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String    // bcrypt hashed
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id])
  active     Boolean   @default(true)
  avatarUrl  String?
  phone      String?
  department String?
  function   String?
  bio        String?
  lastLogin  DateTime?
  lastActiveAt DateTime?
  createdAt  DateTime  @default(now())
}

model SiteSetting {
  id        String   @id @default("1")
  siteName  String   @default("UR-GEDT Portal")
  logo      String   @default("/logo.jpg")
  favicon   String   @default("/favicon.ico")
  address   String   @default("Université de Lubumbashi, Route Kasapa, Lubumbashi, RDC")
  phone     String   @default("+243 990 000 000")
  email     String   @default("contact@urgedt-unilu.org")
  facebook  String   @default("https://facebook.com")
  linkedin  String   @default("https://linkedin.com")
  twitter   String   @default("https://x.com")
  youtube   String   @default("https://youtube.com")
  github    String   @default("https://github.com")
  whatsapp  String   @default("https://wa.me/243990000000")
  updatedAt DateTime @updatedAt @default(now())
}

model News {
  id        String   @id @default(uuid())
  title     String
  content   String
  date      String
  author    String
  image     String?
  category  String
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  date        String
  status      String   // Réalisé, Planifié, En cours
  budget      Float
  researchers String   // Semicolon-separated or JSON array string
  createdAt   DateTime @default(now())
}

model Project {
  id                    String   @id @default(uuid())
  title                 String
  status                String
  progress              Int
  startYear             Int
  duration              String
  principalInvestigator String
  description           String
  objectives            String   // Semicolon-separated or JSON
  partners              String   // Semicolon-separated or JSON
  budgetAmount          Float
  spentAmount           Float
  lastUpdate            String
  createdAt             DateTime @default(now())
}

model Publication {
  id          String   @id @default(uuid())
  title       String
  authors     String
  journal     String
  year        Int
  type        String
  status      String
  doi         String?
  abstractUrl String?
  createdAt   DateTime @default(now())
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String   // photo, video, audio, pdf
  url         String
  date        String
  createdAt   DateTime @default(now())
}

model Partner {
  id              String   @id @default(uuid())
  name            String
  type            String   // Académique, Institutionnel, Technique, Financier
  logo            String
  website         String?
  cooperationType String
  createdAt       DateTime @default(now())
}

model ContactMessage {
  id          String   @id @default(uuid())
  senderName  String
  senderEmail String
  subject     String
  message     String
  date        String
  status      String   // Lu, Non lu
  createdAt   DateTime @default(now())
}

model Recipe {
  id          String   @id @default(uuid())
  description String
  source      String
  amount      Float
  date        String
  recordedBy  String
  type        String   // Subvention, Donation, Prestation, Autre
  createdAt   DateTime @default(now())
  currency      String @default("USD")
}

model Expense {
  id          String   @id @default(uuid())
  description String
  beneficiary String
  amount      Float
  category    String   // Matériel, Logistique, Recherche, RH, Autre
  date        String
  status      String   // Approuvé, En attente, Rejeté
  recordedBy  String
  createdAt   DateTime @default(now())
  currency      String @default("USD")
}

model Budget {
  id                  String @id @default(uuid())
  year                Int    @unique
  totalBudget         Float
  allocatedResearch   Float
  allocatedLogistics  Float
  allocatedEquipment  Float
  allocatedPersonnel  Float
  allocatedMissions   Float @default(0)
  allocatedInvestments Float @default(0)
  currency      String @default("USD")
}

model ExchangeRate {
  id           String   @id @default("1")
  baseCurrency String   @default("EUR")
  eurToUsd     Float    @default(1.0)
  eurToCdf     Float    @default(2800.0)
  updatedAt    DateTime @updatedAt @default(now())
  updatedBy    String?
}

model Log {
  id          String   @id @default(uuid())
  userId      String?
  userName    String
  userRole    String
  action      String
  details     String
  timestamp   DateTime @default(now())
  ip          String?
  userAgent   String?
  oldContent  String?  // JSON string
  newContent  String?  // JSON string
}

model Notification {
  id            String   @id @default(uuid())
  title         String
  message       String
  type          String   // info, warning, success
  isRead        Boolean  @default(false)
  recipientRole String?  // Role name or null for all
  createdAt     DateTime @default(now())
}

// ============================================================================
// ARES FUNDING BUDGET MODULE
// Detailed, category-based budget structure for ARES-style funding
// applications (grant proposals with year-by-year, sub-category-level
// budgeting), separate from the general accounting tables above
// (Recipe/Expense/Budget), which remain unchanged and continue to serve
// day-to-day institutional accounting.
// ============================================================================

enum BudgetLineCategory {
  INVESTISSEMENT
  FONCTIONNEMENT
  PERSONNEL
  EXPEDITION
  FRAIS_ADMIN
}

enum FundingApplicationType {
  AMORCE
  PROJET_PILOTE
  PROJET_STANDARD
}

model FundingApplication {
  id                  String   @id @default(uuid())
  type                FundingApplicationType @default(AMORCE)
  titre               String
  pays                String
  coordonnateurNord   String
  eesCoordonnateurNord String
  coordonnateurSud    String
  eesCoordonnateurSud String
  dureeMois           Int      @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  budgetLines         BudgetLine[]
  bourseLines         BourseBudgetLine[]
  missionLines        MissionBudgetLine[]
}

/// Generic budget line covering Investissement (A), Fonctionnement (B),
/// Personnel (C), Expédition (H), and Frais administratifs (J) — these five
/// tabs share the same core column shape (sous-rubrique, description, year,
/// unit amount, quantity, total), with a couple of category-specific optional
/// fields (etp/unite for Personnel).
model BudgetLine {
  id                  String             @id @default(uuid())
  fundingApplicationId String
  fundingApplication  FundingApplication @relation(fields: [fundingApplicationId], references: [id], onDelete: Cascade)
  category            BudgetLineCategory
  sousRubrique        String             // e.g. "A1", "B3", "C1", "J1"...
  description         String
  anneeIndex          Int                // 1, 2, 3... computed from dureeMois, not a static enum
  montantUnitaire     Decimal            @db.Decimal(12, 2)
  quantite            Decimal            @default(1) @db.Decimal(12, 2)
  total               Decimal            @db.Decimal(12, 2) // computed server-side = montantUnitaire * quantite
  // Personnel-specific (Onglet D) — optional, unused by other categories
  etp                 Decimal?           @db.Decimal(5, 2)
  unite               String?            // "jour", "mois"...
  createdAt           DateTime           @default(now())

  @@index([fundingApplicationId, category, anneeIndex])
}

/// Onglet E. Bourses — genuinely different column structure (two calculated
/// sub-blocks: "Allocation de subsistance" and "Déplacements des boursiers"),
/// so it gets its own model rather than being force-fit into BudgetLine.
model BourseBudgetLine {
  id                    String             @id @default(uuid())
  fundingApplicationId  String
  fundingApplication    FundingApplication @relation(fields: [fundingApplicationId], references: [id], onDelete: Cascade)
  sousRubrique          String             // D1, D2, D3, D4
  description           String
  lieuSejour            String
  anneeIndex            Int

  // Bloc "Allocation de subsistance"
  dureeBourseMois       Decimal  @default(0) @db.Decimal(6, 2)
  montantUnitaireAlloc  Decimal  @default(0) @db.Decimal(12, 2)
  treizemeMois          Decimal  @default(0) @db.Decimal(12, 2)
  fraisInscription      Decimal  @default(0) @db.Decimal(12, 2)
  totalAllocation       Decimal  @db.Decimal(12, 2) // computed = sum of the 4 fields above

  // Bloc "Déplacements des boursiers"
  billetAvion           Decimal  @default(0) @db.Decimal(12, 2)
  trajetAeroportBelgique Decimal @default(0) @db.Decimal(12, 2)
  fraisVisa             Decimal  @default(0) @db.Decimal(12, 2)
  fraisMissionIndirects Decimal  @default(0) @db.Decimal(12, 2)
  totalDeplacements     Decimal  @db.Decimal(12, 2) // computed = sum of the 4 fields above

  createdAt             DateTime @default(now())

  @@index([fundingApplicationId, anneeIndex])
}

/// Onglet F-G. Mission — four calculated sub-blocks (déplacements, per diem,
/// hôtel, frais de gestion), summed into one grand total.
model MissionBudgetLine {
  id                     String             @id @default(uuid())
  fundingApplicationId   String
  fundingApplication     FundingApplication @relation(fields: [fundingApplicationId], references: [id], onDelete: Cascade)
  typeMission            String             // F1, F2...
  typeDeplacement        String             // "Nord-Sud", "Sud-Sud"
  description            String
  anneeIndex             Int
  dureeJours             Int      @default(0)

  // Bloc "Déplacements"
  billetAvion            Decimal  @default(0) @db.Decimal(12, 2)
  deplacementLocal       Decimal  @default(0) @db.Decimal(12, 2)
  totalDeplacement       Decimal  @db.Decimal(12, 2) // computed = billetAvion + deplacementLocal

  // Bloc "Q1 Per diem"
  perDiemUnitaire        Decimal  @default(0) @db.Decimal(12, 2)
  totalPerDiem           Decimal  @db.Decimal(12, 2) // computed = perDiemUnitaire * dureeJours

  // Bloc "Q2 Frais d'hôtel"
  hotelUnitaire          Decimal  @default(0) @db.Decimal(12, 2)
  totalHotel             Decimal  @db.Decimal(12, 2) // computed = hotelUnitaire * dureeJours

  // Bloc "Frais de gestion (accueil)"
  fraisGestionAccueil    Decimal  @default(0) @db.Decimal(12, 2)
  fraisDeplacementsIntl  Decimal  @default(0) @db.Decimal(12, 2)

  // Bloc "Total"
  totalFraisSejour       Decimal  @db.Decimal(12, 2) // computed = totalPerDiem + totalHotel
  totalMontantMission    Decimal  @db.Decimal(12, 2) // computed = sum of all blocks above

  createdAt              DateTime @default(now())

  @@index([fundingApplicationId, anneeIndex])
}

/// Read-only reference table (barème ARES) used to pre-fill/validate Bourse
/// entries. Seeded via prisma/seed.ts; never editable from the UI.
model MontantApplicableBourse {
  id                String  @id @default(uuid())
  typeBourse        String  @unique // "Études", "Doctorat & Postdoctorat", "Renforcement capacités université", "Renforcement HE-ESA"
  trajetAeroport    String
  fraisAdditionnels String
  allocationMensuelle String
  allocation13eMois String
  fraisEncadrement  String
  fraisRecherche    String
  fraisAssurance    String
  fraisGestion      String
  subsistance8_14j  String
  subsistance15j3m  String
  subsistance1_3m   String
}
